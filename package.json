{
  "name": "universe-simulator",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite --port 3100",
    "build": "vite build && vite build --ssr src/app/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs",
    "build:all": "pnpm build && pnpm build-storybook --quiet",
    "preview": "vite preview --port 4183",
    "lint": "eslint",
    "lint:fsd": "steiger ./src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "storybook": "storybook dev -p 6106",
    "build-storybook": "storybook build -o dist/client/storybook",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jost": "5.3.0",
    "solid-js": "1.9.19",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "^1.65.0",
    "@solidjs/testing-library": "0.8.10",
    "@storybook/addon-a11y": "10.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "eslint-plugin-solid": "0.19.0",
    "globals": "17.14.0",
    "jsdom": "^31.0.0",
    "lightningcss": "1.33.0",
    "prettier": "^3.9.10",
    "steiger": "0.10.0",
    "storybook": "10.6.7",
    "storybook-solidjs-vite": "10.7.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vite-plugin-solid": "2.11.16",
    "vitest": "5.1.0"
  }
}
